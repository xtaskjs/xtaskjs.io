{
  "name": "xtaskjs.io",
  "version": "1.0.0",
  "description": "xTaskjs landing page",
  "main": "server.ts",
  "scripts": {
    "build": "npm run prebuild:manifest:app && tsc",
    "build:production": "npm run prebuild:manifest:app && tsc && npm run prebuild:manifest:app",
    "start": "XTASK_IMPORT_CONCURRENCY=16 ts-node server.ts",
    "dev": "XTASK_IMPORT_CONCURRENCY=10 tsx watch server.ts",
    "prebuild:manifest": "ts-node -r tsconfig-paths/register node_modules/@xtaskjs/core/src/cli-build/prebuild.ts",
    "prebuild:manifest:app": "node -e \"const p = require('./node_modules/@xtaskjs/core/src/cli-build/prebuild'); p.prebuildManifest({ srcDir: process.env.APP_SRC || 'src', projectRoot: process.env.APP_ROOT || '.' }).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:sync-package-apis": "tsx scripts/sync-package-api-groups.ts",
    "migration:run": "ts-node src/migrate.ts",
    "seeder:run": "ts-node src/migrate.ts",
    "seed:admin": "ts-node src/seed-admin.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/data-source.ts migration:generate src/migrations/Migration",
    "docker:up": "docker compose up --build || docker-compose up --build",
    "docker:down": "docker compose down || docker-compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@xtaskjs/cache": "^1.0.12",
    "@xtaskjs/common": "^1.0.33",
    "@xtaskjs/core": "^1.0.33",
    "@xtaskjs/cqrs": "^1.1.10",
    "@xtaskjs/event-source": "^1.0.9",
    "@xtaskjs/express-http": "^1.0.30",
    "@xtaskjs/internationalization": "^1.0.14",
    "@xtaskjs/mailer": "^1.0.17",
    "@xtaskjs/scheduler": "^1.0.14",
    "@xtaskjs/security": "^1.0.18",
    "@xtaskjs/socket-io": "^1.0.8",
    "@xtaskjs/throttler": "^1.0.7",
    "@xtaskjs/typeorm": "^1.0.21",
    "@xtaskjs/value-objects": "^1.0.11",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.6",
    "geoip-lite": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-strategy": "^1.0.0",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
